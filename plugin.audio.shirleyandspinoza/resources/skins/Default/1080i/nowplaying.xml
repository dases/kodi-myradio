<?xml version="1.0" encoding="UTF-8"?>
<!--
	The addon's own now-playing bar, drawn as a dialog over the fullscreen visualisation.

	It exists because the skin's own bar cannot be fixed. The cover it draws is the playing
	item's own art, frozen when the stream was resolved - no API in Kodi 21 moves it (see
	the map's ticket 13) - and its right-hand control cluster is the skin's, carrying a
	queue, a favourite, a share, a repeat, lyrics and settings that a live stream has no
	use for.

	Everything here is a binding, so no code in the addon pushes updates: the cover and the
	station's name read window properties the service publishes, the elapsed readout reads
	Player.Time, the wall clock reads System.Time, and the title and artist come from the
	stream's ICY metadata.

	The line along the top is the skin's own top bar, rebuilt here. Kodi draws
	Custom_1109_TopBarOverlay.xml - the station, the now playing item and the wall clock -
	only while its seek bar or its music OSD is up. Ours is neither, which is why the line
	went missing when this window replaced the OSD.
-->
<window type="dialog">
	<defaultcontrol>900</defaultcontrol>
	<controls>
		<!-- Clicking off the bar dismisses it. Playback carries on behind. Listed last, so it
		     is the topmost thing drawn across its area: over the top line, the cover and the
		     transport, rather than under them. -->

		<!-- The scrim and the two labels of the top line. Same texture and same height as
		     the layer the skin's top bar draws for this. -->
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>100%</width>
			<height>170</height>
			<texture>frame/osdfade.png</texture>
		</control>
		<control type="label">
			<left>25</left>
			<top>6</top>
			<width>900</width>
			<height>60</height>
			<aligny>center</aligny>
			<label>$INFO[Window(12006).Property(Station.Name)]</label>
			<font>font30_title</font>
			<shadowcolor>black</shadowcolor>
		</control>
		<control type="label">
			<right>25</right>
			<top>6</top>
			<width>600</width>
			<height>60</height>
			<align>right</align>
			<aligny>center</aligny>
			<label>$INFO[System.Time]</label>
			<font>font_clock</font>
			<shadowcolor>black</shadowcolor>
		</control>

		<!-- The band behind the track, and the extra shade it carries where the song title
		     shows. The band on its own is the skin's own shade of dark and is the same all
		     the way across; the title and artist get a soft-edged extra laid over it, so the
		     white text has something to sit against without the whole band going black. The
		     addon ships this texture because the skin's own for the job is only partly
		     opaque, which over a bright visualisation left the text short of contrast. The
		     path arrives as a window property, since an addon cannot name its own textures
		     from its skin XML. -->
		<control type="image">
			<left>0</left>
			<bottom>0</bottom>
			<width>1920</width>
			<height>280</height>
			<texture fallback="colors/black.png">$INFO[Window(12006).Property(Scrim.Texture)]</texture>
		</control>

		<!-- Cover. The service's artwork is the source; the item's own art is only right up
		     to the first track change, so it is the fallback rather than the other way
		     round. -->
		<control type="image">
			<left>20</left>
			<top>480</top>
			<width>400</width>
			<height>400</height>
			<fadetime>400</fadetime>
			<aspectratio aligny="bottom">keep</aspectratio>
			<texture fallback="DefaultAlbumCover.png" border="2">$INFO[Window(12006).Property(ArtistSlideshow.Image)]</texture>
			<bordertexture colordiffuse="border_alpha">colors/black.png</bordertexture>
			<bordersize>4</bordersize>
			<visible>!String.IsEmpty(Window(12006).Property(ArtistSlideshow.Image))</visible>
		</control>
		<control type="image">
			<left>20</left>
			<top>480</top>
			<width>400</width>
			<height>400</height>
			<fadetime>400</fadetime>
			<aspectratio aligny="bottom">keep</aspectratio>
			<texture fallback="DefaultAlbumCover.png" border="2">$INFO[MusicPlayer.Cover]</texture>
			<bordertexture colordiffuse="border_alpha">colors/black.png</bordertexture>
			<bordersize>4</bordersize>
			<visible>String.IsEmpty(Window(12006).Property(ArtistSlideshow.Image))</visible>
		</control>

		<!-- Inside the scrim band, not above it: over a bright visualisation the title and
		     artist had nothing behind them to read against. -->
		<control type="label">
			<left>440</left>
			<top>820</top>
			<width>1450</width>
			<height>50</height>
			<aligny>center</aligny>
			<label>[B]$INFO[Player.Title][/B]</label>
			<font>font45</font>
			<shadowcolor>black</shadowcolor>
			<scroll>true</scroll>
		</control>
		<control type="label">
			<left>440</left>
			<top>875</top>
			<width>1450</width>
			<height>50</height>
			<aligny>center</aligny>
			<label>$INFO[MusicPlayer.Artist]</label>
			<font>font45</font>
			<shadowcolor>black</shadowcolor>
			<scroll>true</scroll>
		</control>

		<!-- Elapsed time. The stream has no duration and no seeking, so this is all of it. -->
		<control type="label">
			<left>460</left>
			<top>985</top>
			<width>1000</width>
			<height>75</height>
			<align>center</align>
			<aligny>center</aligny>
			<label>$INFO[Player.Time]</label>
			<font>font37</font>
			<shadowcolor>black</shadowcolor>
		</control>

		<!-- Transport: play/pause and stop. It used to be the whole skin bar. -->
		<control type="button" id="900">
			<left>20</left>
			<top>990</top>
			<width>74</width>
			<height>74</height>
			<label></label>
			<font></font>
			<texturefocus colordiffuse="button_focus">osd/fullscreen/buttons/button-fo.png</texturefocus>
			<texturenofocus />
			<onleft>noop</onleft>
			<onright>901</onright>
			<onup>899</onup>
			<ondown>noop</ondown>
		</control>
		<!-- Estuary names these after the action, not the picture: pause.png is the
		     "pause this" bars shown while playing, play.png the "resume" triangle. -->
		<control type="image">
			<left>20</left>
			<top>990</top>
			<width>74</width>
			<height>74</height>
			<texture colordiffuse="white">osd/fullscreen/buttons/pause.png</texture>
			<visible>!Player.Paused</visible>
		</control>
		<control type="image">
			<left>20</left>
			<top>990</top>
			<width>74</width>
			<height>74</height>
			<texture colordiffuse="white">osd/fullscreen/buttons/play.png</texture>
			<visible>Player.Paused</visible>
		</control>
		<control type="button" id="901">
			<left>106</left>
			<top>990</top>
			<width>74</width>
			<height>74</height>
			<label></label>
			<font></font>
			<texturefocus colordiffuse="button_focus">osd/fullscreen/buttons/button-fo.png</texturefocus>
			<texturenofocus />
			<onleft>900</onleft>
			<onright>noop</onright>
			<onup>899</onup>
			<ondown>noop</ondown>
		</control>
		<control type="image">
			<left>106</left>
			<top>990</top>
			<width>74</width>
			<height>74</height>
			<texture colordiffuse="white">osd/fullscreen/buttons/stop.png</texture>
		</control>
		<control type="button" id="899">
			<description>dismiss area</description>
			<left>0</left>
			<top>0</top>
			<width>1920</width>
			<bottom>120</bottom>
			<label></label>
			<font></font>
			<texturefocus />
			<texturenofocus />
			<ondown>900</ondown>
		</control>
	</controls>
</window>
